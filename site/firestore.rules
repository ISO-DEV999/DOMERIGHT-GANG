// Firestore Security Rules for DOMERIGHT GANG
//
// WHY THIS FILE MATTERS:
// This app talks to Firestore directly from the browser using the public
// Firebase client config (that config is NOT a secret — it's meant to be
// public). The only thing standing between "anyone on the internet" and
// your members' data, wallet balances, and inventory is whatever rules are
// published for this project in the Firebase Console. If no custom rules
// have been deployed, Firestore projects created in "test mode" allow full
// public read/write, which means:
//   - Anyone can read every member's name/phone/password hash.
//   - Anyone can read or fake gang wallet transactions, gang funds, leave
//     records, and inventory.
//   - The BACKOFFICE_PIN / WALLET_PIN / LEAVE_LOG_PIN screens in the app
//     are only a UI gate — they do NOT stop direct Firestore reads/writes,
//     since Firestore doesn't know about those PINs at all.
//
// Deploy this file with the Firebase CLI:
//   firebase deploy --only firestore:rules
// or paste it into Firebase Console -> Firestore Database -> Rules.
//
// NOTE: These rules assume the app keeps using plain Firestore reads/writes
// from an unauthenticated client (no Firebase Auth). That means Firestore
// itself cannot verify *who* is asking, only *what shape* of data is being
// read/written. For real per-user access control (e.g. "only Alice can
// change Alice's balance"), migrate logins to Firebase Authentication so
// `request.auth.uid` is available here. Until then, treat the rules below
// as reducing blast radius (no arbitrary writes, no leaking password
// hashes to the public members list), not as a complete access-control
// solution.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- members ---
    // Passwords are managed by Firebase Authentication and are never stored
    // in this profile document.
    match /members/{memberId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
              && request.auth.uid == memberId
              && request.resource.data.keys().hasOnly(
                ['username', 'firstName', 'lastName', 'phone', 'age',
                 'relationshipStatus', 'role', 'createdAt']
                      )
                    && request.resource.data.role == 'Member'
                    && request.resource.data.username is string
                    && request.resource.data.username.size() > 0
                    && request.resource.data.firstName is string
                    && request.resource.data.lastName is string
                    && request.resource.data.phone is string
                    && request.resource.data.age is string
                    && request.resource.data.relationshipStatus is string
                    && request.resource.data.createdAt is string;
      // The admin account is the only actor allowed to adjust staff roles and
      // edit member identities from the backoffice dashboard.
      allow update, delete: if request.auth != null
          && request.auth.token.email == 'iso112011@iso.com';
    }

    // --- gang wallet / funds / inventory / leave records ---
    // Client writes remain disabled until they are moved to a trusted
    // backend that validates ownership, amounts, and staff roles.
    match /gangWallet/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /gangTransactions/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /gangFunds/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /gangLeaves/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /gangInventory/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /gangInventoryLogs/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
